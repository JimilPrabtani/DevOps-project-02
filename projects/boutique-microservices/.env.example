# =============================================================================
# Boutique Microservices — Environment Template
# =============================================================================
# Copy to .env and fill in real values. NEVER commit .env.
#
#   cp .env.example .env
#
# Generate strong secrets (do NOT reuse the placeholders below):
#   openssl rand -base64 48
#
# On Windows PowerShell:
#   [Convert]::ToBase64String((1..48 | ForEach-Object { Get-Random -Max 256 }))
# =============================================================================

# -----------------------------------------------------------------------------
# Database
# -----------------------------------------------------------------------------
# Used by docker-compose to initialise Postgres AND by every backend service
# to build its connection string. There is no default anywhere in the code —
# if these are unset, services fail fast on boot.
POSTGRES_USER=boutique_app
POSTGRES_PASSWORD=CHANGE_ME_generate_with_openssl_rand_base64_48
POSTGRES_DB=postgres
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# -----------------------------------------------------------------------------
# JWT signing material
# -----------------------------------------------------------------------------
# MUST be at least 32 characters. Services refuse to start otherwise.
# ACCESS and REFRESH must be DIFFERENT values — using one secret for both
# lets a refresh token be replayed as an access token.
JWT_ACCESS_SECRET=CHANGE_ME_generate_a_unique_48_byte_secret_min_32_chars
JWT_REFRESH_SECRET=CHANGE_ME_generate_a_DIFFERENT_48_byte_secret_min_32_chars

# Short access token lifetime limits the blast radius of a stolen token.
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
JWT_ISSUER=boutique-auth
JWT_AUDIENCE=boutique-api

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
NODE_ENV=development

# Comma-separated CORS allowlist. NO wildcards — credentials are sent with
# requests, and `Access-Control-Allow-Origin: *` is invalid with credentials.
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Set to true only when serving over HTTPS (sets the Secure flag on cookies).
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# bcrypt work factor. 12 ≈ 250ms per hash on modern hardware.
BCRYPT_ROUNDS=12

# -----------------------------------------------------------------------------
# Rate limiting
# -----------------------------------------------------------------------------
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
AUTH_RATE_LIMIT_MAX=5

# -----------------------------------------------------------------------------
# Service discovery (internal DNS names — not secrets)
# -----------------------------------------------------------------------------
AUTH_SERVICE_URL=http://auth:3002
PRODUCTS_SERVICE_URL=http://product-service:3003
ORDER_SERVICE_URL=http://order-service:3004
ORDERS_SERVICE_URL=http://orders:3005
USERS_SERVICE_URL=http://user-service:3006

# -----------------------------------------------------------------------------
# Observability
# -----------------------------------------------------------------------------
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=CHANGE_ME_do_not_leave_as_admin

# -----------------------------------------------------------------------------
# Frontend (build-time — anything here ships to the browser, never put
# a secret in a REACT_APP_* variable)
# -----------------------------------------------------------------------------
REACT_APP_API_URL=/api

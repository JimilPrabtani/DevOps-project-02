# =============================================================================
# Copy to terraform.tfvars and adjust. terraform.tfvars is gitignored because
# public_access_cidrs contains your home/office IP address.
#
#   cp terraform.tfvars.example terraform.tfvars
# =============================================================================

region   = "us-east-1"
vpc_name = "EKS-Demo-VPC"
vpc_cidr = "10.1.0.0/16"

# Public subnets — load balancers and the NAT gateway only.
subnets = [
  { name = "public-1", cidr_block = "10.1.1.0/24", availability_zone = "us-east-1a" },
  { name = "public-2", cidr_block = "10.1.2.0/24", availability_zone = "us-east-1b" },
  { name = "public-3", cidr_block = "10.1.3.0/24", availability_zone = "us-east-1c" },
]

# Private subnets — worker nodes. No public IPs are assigned here.
private_subnets = [
  { name = "private-1", cidr_block = "10.1.11.0/24", availability_zone = "us-east-1a" },
  { name = "private-2", cidr_block = "10.1.12.0/24", availability_zone = "us-east-1b" },
  { name = "private-3", cidr_block = "10.1.13.0/24", availability_zone = "us-east-1c" },
]

cluster_name    = "eks-cluster"
node_group_name = "eks-node-group"

instance_types = ["m7i-flex.large"]
capacity_type  = "ON_DEMAND"

desired_size = 1
min_size     = 1
max_size     = 2

disk_size = 30

repositories = [
  "frontend",
  "gateway",
  "auth",
  "order-service",
  "orders",
  "product-service",
  "user-service",
]

# ---------------------------------------------------------------------------
# SECURITY — you MUST set this. Terraform will reject 0.0.0.0/0.
#
#   curl -s https://checkip.amazonaws.com
# ---------------------------------------------------------------------------
public_access_cidrs = ["REPLACE_WITH_YOUR_IP/32"]

endpoint_public_access    = true
enable_secrets_encryption = true
argocd_server_insecure    = false

# Cost controls. Setting enable_nat_gateway = false saves ~$32/month but
# private nodes then cannot pull images without VPC endpoints.
enable_nat_gateway = true
single_nat_gateway = true
enable_flow_logs   = true
